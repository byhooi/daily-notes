{
  "name": "daily-notes",
  "version": "1.0.0",
  "description": "每日积累教育网站",
  "scripts": {
    "check:generated": "node scripts/check-generated.mjs",
    "test": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test",
    "build:css": "tailwindcss -i ./assets/tailwind.source.css -o ./assets/tailwind.min.css --minify",
    "build:pages": "node scripts/build-pages.mjs",
    "build": "npm run build:css && npm run build:pages",
    "watch:css": "tailwindcss -i ./assets/tailwind.source.css -o ./assets/tailwind.min.css --watch"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "tailwindcss": "^3.4.0"
  },
  "keywords": [
    "education",
    "chinese",
    "learning"
  ],
  "author": "",
  "license": "MIT"
}
